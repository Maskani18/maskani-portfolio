# MASKANI — Variabel lingkungan publik.
#
# Salin ke `.env.local` untuk pengembangan lokal.
# Di Vercel, diset lewat Project Settings → Environment Variables.
#
# Penanda produksi untuk robots dan noindex (§14.2, CI-05):
#   - "production"  → robots diizinkan, sitemap lengkap.
#   - Selain itu    → noindex, sitemap kosong (default untuk preview).
NEXT_PUBLIC_SITE_ENV=preview