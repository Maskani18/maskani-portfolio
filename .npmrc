# MASKANI — Konfigurasi npm.
#
# Sebab: @tailwindcss/oxide menyertakan native binding + WASM fallback
# (@emnapi/core, @emnapi/runtime) sebagai optional deps. Di Windows, npm
# menganggap native binary cukup dan tidak mencatat WASM fallback ke
# lockfile; di Linux CI npm ci menuntut mereka ada → EUSAGE.
# Tujuan: paksa npm merekam semua optional deps ke lockfile agar `npm ci`
# di CI (Linux) sinkron dengan `npm install` di lokal (Windows).
# Perilaku: tidak mengubah runtime; hanya memengaruhi penyusunan lockfile.

include=optional